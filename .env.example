# ============================================================
#  Text-to-SQL — Configuration de l'environnement
#  Copiez ce fichier en .env et remplissez vos valeurs
# ============================================================

# --- Base de données cible (PostgreSQL recommandé) ---
DATABASE_URL=postgresql://user:password@localhost:5432/mydb
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/mydb
# DATABASE_URL=sqlite:///./mydb.sqlite

# --- LLM Local (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Embeddings (Sentence Transformers - open-source) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_SCHEMA=schema_chunks
CHROMA_COLLECTION_FEWSHOT=few_shot_examples

# --- Self-correction ---
MAX_CORRECTION_ATTEMPTS=3

# --- Sécurité ---
SQL_READ_ONLY=true

# --- Streamlit ---
STREAMLIT_THEME=dark

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
